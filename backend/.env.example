# ==============================================================================
# E-Pupuk Kabupaten Mojokerto - Backend Environment Variables
# Salin file ini menjadi '.env' di folder backend/ atau sesuaikan dengan MySQL Anda.
# ==============================================================================

# Aplikasi & Keamanan JWT
PROJECT_NAME="E-Pupuk Kabupaten Mojokerto"
API_V1_STR=/api
SECRET_KEY=epupuk-mojokerto-super-secret-key-2026-secure-jwt
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Konfigurasi Database MySQL / MariaDB (XAMPP / Laragon / Standalone)
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_USER=root
MYSQL_PASSWORD=
MYSQL_DB=epupuk
