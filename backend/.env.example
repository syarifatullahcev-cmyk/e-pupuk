# ==============================================================================
# E-Pupuk Kabupaten Mojokerto - Backend Environment Variables
# Salin file ini menjadi '.env' di folder backend/
# ==============================================================================

# Aplikasi & Keamanan JWT
PROJECT_NAME="E-Pupuk Kabupaten Mojokerto"
API_V1_STR=/api
SECRET_KEY=epupuk-mojokerto-super-secret-key-2026-secure-jwt
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Konfigurasi Database MySQL
# Gunakan MYSQL_HOST=db  → jika dijalankan via Docker Compose
# Gunakan MYSQL_HOST=127.0.0.1 → jika dijalankan lokal (XAMPP/Laragon)
MYSQL_HOST=db
MYSQL_PORT=3306
MYSQL_USER=epupuk_user
MYSQL_PASSWORD=epupuk_pass
MYSQL_DB=epupuk

